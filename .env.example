# Administrator credentials. Generate them with:
#   npm run admin:hash -- --email you@example.org --write
# Only a salted PBKDF2 hash is stored here, never the password.
# Copy the generated lines into .env.local (git-ignored) or your hosting environment.
VITE_ADMIN_EMAIL=
VITE_ADMIN_NAME=Administración
VITE_ADMIN_SALT=
VITE_ADMIN_HASH=
VITE_ADMIN_ITERATIONS=150000
